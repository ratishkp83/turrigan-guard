{
  "manifest_version": 3,
  "name": "Turrigan Guard for Enterprise",
  "version": "1.0.1",
  "description": "On-device PII block for AI apps, plus a tamper-evident audit trail in your Turrigan tenant when a user proceeds. Subscription-gated.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://api.turrigan.com/*"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://m365.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Turrigan Guard for Enterprise",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "storage": {
    "managed_schema": "schema/managed_schema.json"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://m365.cloud.microsoft/*"
      ],
      "js": [
        "core/detector.js",
        "edition.js",
        "core/guard-core.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
